{
  "name": "@cloudstrytech/ui-components",
  "version": "1.0.20",
  "description": "Reusable Material Web (M3) UI components for React and Next.js",
  "private": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles.css": {
      "default": "./dist/esm/styles.css"
    },
    "./icons": {
      "import": "./dist/esm/icons/index.js",
      "require": "./dist/cjs/icons/index.js"
    },
    "./button": {
      "import": "./dist/esm/components/buttons/index.js",
      "require": "./dist/cjs/components/buttons/index.js",
      "types": "./dist/types/button.d.ts"
    },
    "./input": {
      "import": "./dist/esm/components/input/index.js",
      "require": "./dist/cjs/components/input/index.js",
      "types": "./dist/types/input.d.ts"
    },
    "./passwordField": {
      "import": "./dist/esm/components/passwordField/index.js",
      "require": "./dist/cjs/components/passwordField/index.js",
      "types": "./dist/types/passwordField.d.ts"
    },
    "./searchField": {
      "import": "./dist/esm/components/searchField/index.js",
      "require": "./dist/cjs/components/searchField/index.js",
      "types": "./dist/types/searchField.d.ts"
    },
    "./otp": {
      "import": "./dist/esm/components/otp/index.js",
      "require": "./dist/cjs/components/otp/index.js",
      "types": "./dist/types/otp.d.ts"
    },
    "./footer": {
      "import": "./dist/esm/components/footer/index.js",
      "require": "./dist/cjs/components/footer/index.js",
      "types": "./dist/types/footer.d.ts"
    },
    "./table": {
      "import": "./dist/esm/components/table/index.js",
      "require": "./dist/cjs/components/table/index.js",
      "types": "./dist/types/table.d.ts"
    },
    "./card": {
      "import": "./dist/esm/components/card/index.js",
      "require": "./dist/cjs/components/card/index.js",
      "types": "./dist/types/card.d.ts"
    },
    "./badge": {
      "import": "./dist/esm/components/badge/index.js",
      "require": "./dist/cjs/components/badge/index.js",
      "types": "./dist/types/badge.d.ts"
    },
    "./checkbox": {
      "import": "./dist/esm/components/checkbox/index.js",
      "require": "./dist/cjs/components/checkbox/index.js",
      "types": "./dist/types/checkbox.d.ts"
    },
    "./chips": {
      "import": "./dist/esm/components/chips/index.js",
      "require": "./dist/cjs/components/chips/index.js",
      "types": "./dist/types/chips.d.ts"
    },
    "./dialog": {
      "import": "./dist/esm/components/dialog/index.js",
      "require": "./dist/cjs/components/dialog/index.js",
      "types": "./dist/types/dialog.d.ts"
    },
    "./divider": {
      "import": "./dist/esm/components/divider/index.js",
      "require": "./dist/cjs/components/divider/index.js",
      "types": "./dist/types/divider.d.ts"
    },
    "./fab": {
      "import": "./dist/esm/components/fab/index.js",
      "require": "./dist/cjs/components/fab/index.js",
      "types": "./dist/types/fab.d.ts"
    },
    "./iconbutton": {
      "import": "./dist/esm/components/iconbutton/index.js",
      "require": "./dist/cjs/components/iconbutton/index.js",
      "types": "./dist/types/iconbutton.d.ts"
    },
    "./list": {
      "import": "./dist/esm/components/list/index.js",
      "require": "./dist/cjs/components/list/index.js",
      "types": "./dist/types/list.d.ts"
    },
    "./menu": {
      "import": "./dist/esm/components/menu/index.js",
      "require": "./dist/cjs/components/menu/index.js",
      "types": "./dist/types/menu.d.ts"
    },
    "./progress": {
      "import": "./dist/esm/components/progress/index.js",
      "require": "./dist/cjs/components/progress/index.js",
      "types": "./dist/types/progress.d.ts"
    },
    "./radio": {
      "import": "./dist/esm/components/radio/index.js",
      "require": "./dist/cjs/components/radio/index.js",
      "types": "./dist/types/radio.d.ts"
    },
    "./slider": {
      "import": "./dist/esm/components/slider/index.js",
      "require": "./dist/cjs/components/slider/index.js",
      "types": "./dist/types/slider.d.ts"
    },
    "./snackbar": {
      "import": "./dist/esm/components/snackbar/index.js",
      "require": "./dist/cjs/components/snackbar/index.js",
      "types": "./dist/types/snackbar.d.ts"
    },
    "./switch": {
      "import": "./dist/esm/components/switch/index.js",
      "require": "./dist/cjs/components/switch/index.js",
      "types": "./dist/types/switch.d.ts"
    },
    "./tabs": {
      "import": "./dist/esm/components/tabs/index.js",
      "require": "./dist/cjs/components/tabs/index.js",
      "types": "./dist/types/tabs.d.ts"
    },
    "./tooltip": {
      "import": "./dist/esm/components/tooltip/index.js",
      "require": "./dist/cjs/components/tooltip/index.js",
      "types": "./dist/types/tooltip.d.ts"
    },
    "./ssr": {
      "import": "./dist/esm/ssr.js",
      "require": "./dist/cjs/ssr.js",
      "types": "./dist/types/ssr.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "src/**/*.css",
    "@material/web/**"
  ],
  "peerDependencies": {
    "@floating-ui/react": ">=0.26.0",
    "@material/web": ">=1.0.0 <3.0.0",
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist/types",
    "postbuild:types": "node scripts/flatten-types.js",
    "build": "npm run clean && rollup -c && npm run build:types && npm run postbuild:types",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.19"
  }
}
